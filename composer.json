{
  "name": "hospital/nurseroster",
  "type": "project",
  "description": "Arabic nurse roster Laravel application",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "phpoffice/phpspreadsheet": "^4.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
